# A profile selector is mandatory. There is no implicit chain default and the CLI does not
# auto-load this file; load it through the calling process after review.
KTRACE_CHAIN_PROFILE=botchain_testnet
KTRACE_CHAIN_ID=968

# Local runtime artifacts are ignored by git. G0.5 adds fingerprint-scoped subdirectories.
KTRACE_DATA_DIR=.runtime
